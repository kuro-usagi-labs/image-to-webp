{
  "name": "image-to-webp-electron",
  "version": "2.5.3",
  "description": "Desktop app to convert images to WebP, AVIF, JPEG, and PNG",
  "main": "electron-main.js",
  "author": "Gilang",
  "license": "MIT",
  "homepage": "https://github.com/kuro-usagi-labs/image-to-webp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuro-usagi-labs/image-to-webp.git"
  },
  "bugs": {
    "url": "https://github.com/kuro-usagi-labs/image-to-webp/issues"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:electron": "node scripts/run-electron-smoke.cjs",
    "start": "node scripts/start-electron.js",
    "clean:dist": "node scripts/clean-dist.js",
    "generate:icon": "node scripts/generate-icon.js",
    "build:win": "node scripts/clean-dist.js && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win --publish never",
    "build:portable": "node scripts/clean-dist.js && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win portable --publish never",
    "build:win:signed": "node scripts/clean-dist.js && electron-builder --win --config.win.signExecutable=true --publish never",
    "build:portable:signed": "node scripts/clean-dist.js && electron-builder --win portable --config.win.signExecutable=true --publish never",
    "build:win:signed:local": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-signed.ps1 -Target win",
    "build:portable:signed:local": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-signed.ps1 -Target portable",
    "build:win:selfsigned:local": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-self-signed-local.ps1 -Target win",
    "build:portable:selfsigned:local": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\build-self-signed-local.ps1 -Target portable",
    "test:ui": "node scripts/run-electron-smoke.cjs --ui",
    "release:checksums": "node scripts/release-checksums.cjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "p-limit": "^7.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "axe-core": "^4.14.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "jsdom": "^31.0.1",
    "png-to-ico": "^3.0.2"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8"
  },
  "build": {
    "appId": "com.gilang.pngtowebp",
    "productName": "Image to WebP",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "kuro-usagi-labs",
        "repo": "image-to-webp"
      }
    ],
    "files": [
      "electron-main.js",
      "preload.js",
      "lib/**/*.js",
      "ui/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "win": {
      "icon": "ui/app.ico",
      "signAndEditExecutable": true,
      "signExecutable": false,
      "signtoolOptions": {
        "publisherName": "Kuro Usagi"
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Image-to-WebP-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "ui/app.ico",
      "uninstallerIcon": "ui/app.ico",
      "installerHeaderIcon": "ui/app.ico"
    },
    "portable": {
      "artifactName": "Image-to-WebP-${version}.${ext}"
    }
  }
}
